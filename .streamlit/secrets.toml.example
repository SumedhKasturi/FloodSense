# Copy to .streamlit/secrets.toml (git-ignored) and fill in your values.
# NWS requires a User-Agent that identifies the app and gives a contact.
NWS_USER_AGENT = "FloodSense (your-email@example.com)"
# Supabase project URL and anon key (Project Settings -> API). Run supabase/schema.sql once first.
# The deployed app never uses the service-role key (see SUPABASE_SERVICE_KEY below).
SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_KEY = "your-supabase-anon-key"
# Phone alerts (story 6): a random suffix that makes each ZIP's ntfy topic unguessable.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(16))"
NTFY_TOPIC_SECRET = "your-random-topic-secret"
# Public app link used in push messages (defaults to http://localhost:8501).
APP_URL = "https://your-app.streamlit.app"
# Service-role key, only for running the scheduled alerts job (python -m alerts.check) locally.
# The deployed app never needs it; in production it lives only in GitHub Actions secrets.
SUPABASE_SERVICE_KEY = "your-supabase-service-role-key"
